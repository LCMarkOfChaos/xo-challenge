<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MarkOfChaos X/O Challenge</title>

<style>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        font-family: Arial, sans-serif;
        text-align: center;
        color: white;
    }

    body {
        background-image: url("image/background.png");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        text-shadow: 2px 2px 4px #000;
    }

    #game {
        width: 100%;
        min-height: 100vh;
        position: relative;
        padding-top: 30px;
        box-sizing: border-box;
    }

    h1 {
        margin: 10px 0 25px 0;
        font-size: 42px;
        color: white;
    }

    #question {
        font-size: 28px;
        font-weight: bold;
        margin: 30px auto;
        max-width: 900px;
        color: white;
    }

    #status {
        font-size: 24px;
        font-weight: bold;
        margin: 20px auto;
        min-height: 35px;
        color: white;
    }

    #answers {
        display: flex;
        justify-content: center;
        gap: 30px;
        flex-wrap: wrap;
        margin: 30px auto;
        max-width: 1000px;
    }

    .answer-button {
        width: 400px;
        min-height: 80px;
        padding: 15px;
        font-size: 24px;
        font-weight: bold;
        border: 3px solid white;
        border-radius: 12px;
        background: rgba(0, 0, 0, 0.75);
        color: white;
        cursor: pointer;
        text-shadow: 2px 2px 3px #000;
    }

    .answer-button:hover {
        background: rgba(60, 60, 60, 0.9);
    }

    .answer-button:disabled {
        cursor: default;
    }

    #startButton,
    #nextButton,
    #restartButton {
        font-size: 20px;
        font-weight: bold;
        padding: 14px 25px;
        border: 2px solid white;
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.8);
        color: white;
        cursor: pointer;
        text-shadow: 2px 2px 3px #000;
    }

    #startButton {
        position: fixed;
        top: 10px;
        left: 10px;
        z-index: 1000;
    }

    #nextButton,
    #restartButton {
        margin-top: 20px;
    }

    #startButton:hover,
    #nextButton:hover,
    #restartButton:hover {
        background: rgba(60, 60, 60, 0.95);
    }

    #explanation {
        font-size: 21px;
        font-weight: bold;
        max-width: 850px;
        margin: 25px auto;
        padding: 15px;
        color: white;
    }

    #score {
        font-size: 24px;
        font-weight: bold;
        margin: 20px;
        color: white;
    }

    #progress {
        font-size: 20px;
        margin: 10px;
        color: white;
    }

    #version {
        position: fixed;
        bottom: 5px;
        left: 10px;
        font-size: 14px;
        color: white;
        text-shadow: 2px 2px 4px #000;
        z-index: 1000;
    }

    .hidden {
        display: none !important;
    }

    @media (max-width: 700px) {
        h1 {
            font-size: 32px;
        }

        #question {
            font-size: 23px;
            padding: 0 15px;
        }

        .answer-button {
            width: 85%;
            font-size: 20px;
        }
    }
</style>
</head>

<body>

<div id="game">

    <h1>X/O Challenge</h1>

    <button id="startButton">START</button>

    <div id="progress"></div>

    <div id="question">Press START to begin.</div>

    <div id="status"></div>

    <div id="answers" class="hidden">
        <button class="answer-button" id="answer0"></button>
        <button class="answer-button" id="answer1"></button>
    </div>

    <div id="explanation"></div>

    <button id="nextButton" class="hidden">NEXT</button>

    <div id="score"></div>

    <button id="restartButton" class="hidden">PLAY AGAIN</button>

</div>

<footer id="version">Version 1.1</footer>

<script>

let allQuestions = [];
let gameQuestions = [];

let currentQuestion = null;
let currentQuestionIndex = 0;
let score = 0;

const questionsPerGame = 10;

let currentDifficulty = 5;

const startButton = document.getElementById("startButton");
const nextButton = document.getElementById("nextButton");
const restartButton = document.getElementById("restartButton");

const questionElement = document.getElementById("question");
const statusElement = document.getElementById("status");
const explanationElement = document.getElementById("explanation");

const answer0 = document.getElementById("answer0");
const answer1 = document.getElementById("answer1");

const answersElement = document.getElementById("answers");

const progressElement = document.getElementById("progress");
const scoreElement = document.getElementById("score");


/* --------------------------------
   LOAD QUESTIONS
-------------------------------- */

fetch("questions.json", { cache: "no-store" })
    .then(response => {
        if (!response.ok) {
            throw new Error("Could not load questions.json");
        }

        return response.json();
    })
    .then(data => {

        allQuestions = data.questions || [];

        console.log("Loaded questions:", allQuestions.length);

    })
    .catch(error => {

        console.error(error);

        questionElement.textContent =
            "Error loading questions.";

    });


/* --------------------------------
   RANDOMIZE ARRAY
-------------------------------- */

function shuffle(array) {

    for (let i = array.length - 1; i > 0; i--) {

        const j = Math.floor(Math.random() * (i + 1));

        [array[i], array[j]] =
            [array[j], array[i]];
    }

    return array;
}


/* --------------------------------
   RANDOMIZE ANSWER BUTTON ORDER
-------------------------------- */

function randomizeAnswers(question) {

    const randomized = {
        ...question,
        answers: [...question.answers]
    };

    /*
       correct = 0 means the first
       answer in the JSON is correct.

       correct = 1 means the second
       answer in the JSON is correct.

       If the buttons are swapped,
       the correct number must also swap.
    */

    if (Math.random() < 0.5) {

        [
            randomized.answers[0],
            randomized.answers[1]
        ] = [
            randomized.answers[1],
            randomized.answers[0]
        ];

        randomized.correct =
            question.correct === 0 ? 1 : 0;
    }

    return randomized;
}


/* --------------------------------
   GET NEXT QUESTION
-------------------------------- */

function getNextQuestion() {

    let candidates =
        allQuestions.filter(q =>
            !gameQuestions.some(
                used => used.question === q.question
            )
        );

    if (candidates.length === 0) {
        return null;
    }


    /*
       After a correct answer:
       same difficulty or harder.
    */

    if (currentQuestion &&
        currentQuestion.wasCorrect === true) {

        let harderOrSame =
            candidates.filter(q =>
                q.difficulty >= currentDifficulty
            );

        if (harderOrSame.length > 0) {

            candidates = harderOrSame;

        }

    }


    /*
       After a wrong answer:
       easier than current difficulty.
    */

    else if (currentQuestion &&
             currentQuestion.wasCorrect === false) {

        let easier =
            candidates.filter(q =>
                q.difficulty < currentDifficulty
            );

        if (easier.length > 0) {

            candidates = easier;

        }

    }


    /*
       Pick the closest difficulty available.
    */

    candidates.sort((a, b) => {

        return Math.abs(
            a.difficulty - currentDifficulty
        ) -
        Math.abs(
            b.difficulty - currentDifficulty
        );

    });


    /*
       Randomize among questions with
       the same closest difficulty.
    */

    const closestDifference =
        Math.abs(
            candidates[0].difficulty -
            currentDifficulty
        );

    const closest =
        candidates.filter(q =>
            Math.abs(
                q.difficulty -
                currentDifficulty
            ) === closestDifference
        );

    return closest[
        Math.floor(Math.random() * closest.length)
    ];
}


/* --------------------------------
   START GAME
-------------------------------- */

function startGame() {

    if (allQuestions.length === 0) {

        questionElement.textContent =
            "Questions are still loading.";

        return;
    }

    gameQuestions = [];

    currentQuestion = null;

    currentQuestionIndex = 0;

    score = 0;

    currentDifficulty = 5;

    startButton.classList.add("hidden");

    restartButton.classList.add("hidden");

    nextButton.classList.add("hidden");

    explanationElement.textContent = "";

    scoreElement.textContent = "";

    showNextQuestion();
}


/* --------------------------------
   SHOW NEXT QUESTION
-------------------------------- */

function showNextQuestion() {

    if (currentQuestionIndex >= questionsPerGame) {

        endGame();

        return;
    }


    const selected =
        getNextQuestion();

    if (!selected) {

        endGame();

        return;
    }


    currentQuestion =
        randomizeAnswers(selected);

    gameQuestions.push(currentQuestion);

    currentQuestionIndex++;


    /*
       Difficulty becomes the difficulty
       of the question just selected.
    */

    currentDifficulty =
        currentQuestion.difficulty;


    progressElement.textContent =
        "Question " +
        currentQuestionIndex +
        " of " +
        questionsPerGame;


    questionElement.textContent =
        currentQuestion.question;

    statusElement.textContent =
        "Get ready...";


    explanationElement.textContent = "";

    nextButton.classList.add("hidden");

    answersElement.classList.add("hidden");


    answer0.disabled = false;
    answer1.disabled = false;


    /*
       Put the randomized answers
       into the two buttons.
    */

    answer0.textContent =
        currentQuestion.answers[0];

    answer1.textContent =
        currentQuestion.answers[1];


    /*
       Three-second preparation time.
    */

    setTimeout(() => {

        if (!currentQuestion) {
            return;
        }

        statusElement.textContent =
            "Choose your answer!";

        answersElement.classList.remove("hidden");


    }, 3000);
}


/* --------------------------------
   ANSWER BUTTONS
-------------------------------- */

answer0.addEventListener(
    "click",
    () => checkAnswer(0)
);

answer1.addEventListener(
    "click",
    () => checkAnswer(1)
);


/* --------------------------------
   CHECK ANSWER
-------------------------------- */

function checkAnswer(selectedAnswer) {

    answer0.disabled = true;
    answer1.disabled = true;


    const correct =
        selectedAnswer === currentQuestion.correct;


    currentQuestion.wasCorrect = correct;


    if (correct) {

        score++;

        statusElement.textContent =
            "CORRECT!";

        explanationElement.textContent =
            currentQuestion.correctExplanation;

    }
    else {

        statusElement.textContent =
            "WRONG!";

        explanationElement.textContent =
            currentQuestion.wrongExplanation;

    }


    scoreElement.textContent =
        "Score: " +
        score +
        " / " +
        currentQuestionIndex;


    nextButton.classList.remove("hidden");
}


/* --------------------------------
   NEXT BUTTON
-------------------------------- */

nextButton.addEventListener(
    "click",
    () => {

        showNextQuestion();

    }
);


/* --------------------------------
   END GAME
-------------------------------- */

function endGame() {

    answersElement.classList.add("hidden");

    nextButton.classList.add("hidden");

    questionElement.textContent =
        "Challenge Complete!";

    progressElement.textContent = "";

    statusElement.textContent =
        "Final Score";

    explanationElement.textContent = "";

    scoreElement.textContent =
        score +
        " / " +
        questionsPerGame;

    restartButton.classList.remove("hidden");
}


/* --------------------------------
   PLAY AGAIN
-------------------------------- */

restartButton.addEventListener(
    "click",
    () => {

        startGame();

    }
);


/* --------------------------------
   START BUTTON
-------------------------------- */

startButton.addEventListener(
    "click",
    () => {

        startGame();

    }
);

</script>

</body>
</html>
